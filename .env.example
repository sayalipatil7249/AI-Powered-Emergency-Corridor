# Copy this file to .env and fill in your own values.

# PostgreSQL database with the PostGIS extension enabled.
DATABASE_URL=postgresql://USERNAME:PASSWORD@localhost:5432/emergency_corridor

# Websites allowed to call the API, comma separated. Default: the local
# dev server. On a server, set it to the address the dashboard is opened
# at, e.g. https://corridor.example.org
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SUMO's install folder, only if you use your own SUMO install: the pip
# package eclipse-sumo (in requirements.txt) is found by itself.
# SUMO_HOME=/usr/share/sumo

# SUMO runs WITHOUT its own window by default (as on a server); the
# dashboard shows everything. Set SUMO_GUI=1 to also open SUMO's window
# (needs a screen; it can hang on Apple Silicon Macs).
# SUMO_GUI=0

# Optional: the simulated area. original (default, 4.2 x 3.3 km of
# central Pune, what the AI models were trained on) or 2x (5.9 x 4.7 km).
# SIM_AREA=original

# Optional, for demos: always use this traffic level (light, normal or
# heavy) instead of the live one.
# SIM_TRAFFIC_LEVEL=heavy

# Optional: set to 0 so drivers do not make room for the siren.
# GIVE_WAY=1

# Claude API key: the "Ask AI" chat, "Describe the emergency" (AI fills
# in the trip) and the AI supervisor agent (python -m agent.run). Without
# it those features say they are off; everything else works.
# Get one at https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: model and effort of the "Ask AI" chat and the AI intake.
# ASSISTANT_MODEL=claude-opus-5-5
# ASSISTANT_EFFORT=low

# Optional: live Pune traffic for the digital twin (TomTom developer key
# with Traffic Flow API + Routing API enabled). Without it the simulation
# uses normal simulated traffic.
# TOMTOM_API_KEY=...

# Optional: agent model and effort (defaults: claude-opus-5, low)
# AGENT_MODEL=claude-opus-5
# AGENT_EFFORT=low

# Optional: phone calls to police stations when a road without signals
# jams ahead of the ambulance (Twilio voice). Enable India in Twilio's
# Voice geo permissions and verify every test phone in a trial account.
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_FROM_NUMBER=+1...
# TEST phone that stands in for every station (never a real police number).
# Per-station test phones: police_contacts.json (see police_contacts.example.json).
# POLICE_ALERT_PHONE=+91XXXXXXXXXX   (+91 and the 10-digit mobile number; spaces are fine)
# Set to 0 to switch real calls off (the call is only written to the log).
# POLICE_CALLS=0
