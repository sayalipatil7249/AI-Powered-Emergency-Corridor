<?xml version="1.0" encoding="UTF-8"?>
<!--
    Pune driving profile for background traffic.

    Trips without a type use DEFAULT_VEHTYPE, so redefining it here
    (loaded before the route files) changes every background car.

    speedFactor: drivers' desired speed as a fraction of the speed limit.
        Mixed traffic (two-wheelers, auto-rickshaws, pedestrians, roadside
        activity) keeps real Pune speeds well below the posted limit.
        Mean 0.55 (about 27 km/h on a 50 km/h road); even the fastest
        drivers stay at 0.75 (37.5 km/h), below the ambulance with its
        siren (ambulance_vtype.add.xml).
    sigma: driver imperfection (0 = perfect, 1 = very erratic).
    minGap: shorter gaps than SUMO's European default (2.5 m), as seen
        in Indian city traffic.
    tau: reaction time. Must not be below the simulation step (1 s,
        sumo_bridge.py): with tau 0.9 SUMO cannot keep cars apart and
        they overlap (thousands of collisions per heavy-traffic run).
-->
<additional>
    <vType
        id="DEFAULT_VEHTYPE"
        vClass="passenger"
        speedFactor="normc(0.55,0.1,0.3,0.75)"
        sigma="0.6"
        minGap="1.5"
        tau="1.0"
    />
</additional>
